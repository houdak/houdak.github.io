---
import Layout from '../layouts/Layout.astro';

const audio = [
	{
		title: "Frivolous Science",
		image: "/other-work/FrivolousScience.png",
		publication: "Apple Podcasts",
		url: "https://podcasts.apple.com/us/podcast/frivolous-science/id1848023613",
		linkLabel: "Listen ↗",
	},
];

const writing = [
	{
		title: "To Succeed in My Ph.D., I Had to Rethink My Mother's Story",
		publication: "Science",
		image: "/other-work/sciencephd.jpg",
		url: "https://www.science.org/content/article/succeed-my-ph-d-i-had-rethink-my-mother-s-story",
		linkLabel: "Read ↗",
	},
	{
		title: "How My Mentor Changed My Life",
		publication: "Code Like A Girl",
		url: "https://code.likeagirl.io/how-my-mentor-changed-my-life-2b322c7f7eba",
		linkLabel: "Read ↗",
	},
];
---

<Layout title="Other Work — Houda Khaled">
	<main>
		<header class="page-header">
			<p class="eyebrow">Outreach</p>
			<h1>Other Work</h1>
			<div class="rule"></div>
		</header>

		<h2 class="section-label reveal">Audio</h2>
		<section class="pub-list reveal">
			{audio.map(piece => (
				<article class="pub-entry">
					<div class="pub-body">
						<p class="pub-title">{piece.title}</p>
						<p class="pub-journal">{piece.publication}</p>
						<div class="pub-links">
							<a href={piece.url} target="_blank" rel="noopener noreferrer" class="pub-link">
								{piece.linkLabel}
							</a>
						</div>
					</div>
					{piece.image && <img src={piece.image} alt={piece.title} class="pub-image" />}
				</article>
			))}
		</section>

		<h2 class="section-label reveal">Writing</h2>
		<section class="pub-list no-dividers reveal">
			{writing.map(piece => (
				<article class="pub-entry">
					<div class="pub-body">
						<p class="pub-title">{piece.title}</p>
						<p class="pub-journal">{piece.publication}</p>
						<div class="pub-links">
							<a href={piece.url} target="_blank" rel="noopener noreferrer" class="pub-link">
								{piece.linkLabel}
							</a>
						</div>
					</div>
					{piece.image && <img src={piece.image} alt={piece.title} class="pub-image" />}
				</article>
			))}
		</section>
	</main>
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
		const reveals = document.querySelectorAll<HTMLElement>('.reveal');
		const io = new IntersectionObserver((entries) => {
			entries.forEach(e => {
				if (e.isIntersecting) {
					(e.target as HTMLElement).classList.add('in-view');
					io.unobserve(e.target);
				}
			});
		}, { threshold: 0.05 });
		reveals.forEach(el => io.observe(el));
	});
</script>

<style>
	main {
		position: relative;
		z-index: 1;
		max-width: 900px;
		margin: 0 auto;
		padding: 3rem 1.5rem 7rem;
	}

	/* ── Page header ── */
	.page-header { margin-bottom: 4rem; }

	.eyebrow {
		font-family: 'Space Mono', monospace;
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-muted);
		margin-bottom: 0.6rem;
	}

	h1 {
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 700;
		font-size: clamp(3rem, 10vw, 5.5rem);
		line-height: 0.95;
		letter-spacing: -0.03em;
		margin-bottom: 1.5rem;
		color: var(--ink);
		text-shadow:
			0 0 50px rgba(57,255,20,0.2),
			0 0 120px rgba(57,255,20,0.07);
	}

	.rule {
		height: 1px;
		background: linear-gradient(to right, var(--gfp), var(--ink-dim) 55%, transparent);
	}

	/* ── Subsection labels ── */
	.section-label {
		font-family: 'Space Mono', monospace;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-muted);
		margin-top: 3rem;
		margin-bottom: 0.25rem;
	}

	/* ── Entry list ── */
	.pub-list {
		display: flex;
		flex-direction: column;
	}

	.pub-entry {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
		padding: 2rem 0;
		border-bottom: 1px solid var(--ink-dim);
	}
	.pub-entry:last-child { border-bottom: none; }
	.no-dividers .pub-entry { border-bottom: none; }

	.pub-image {
		width: 120px;
		height: 120px;
		object-fit: cover;
		flex-shrink: 0;
		filter: grayscale(20%);
		margin-left: auto;
	}

	@media (max-width: 600px) {
		.pub-entry { flex-direction: column; }
		.pub-image { width: 100%; height: 160px; }
	}

	.pub-title {
		font-weight: 500;
		font-size: 1rem;
		line-height: 1.45;
		margin-bottom: 0.4rem;
		color: var(--ink);
	}

	.pub-journal {
		font-family: 'Space Mono', monospace;
		font-size: 0.72rem;
		color: var(--ink-muted);
		margin-bottom: 0.75rem;
	}

	.pub-links { display: flex; gap: 1rem; }

	.pub-link {
		font-family: 'Space Mono', monospace;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-muted);
		border-bottom: 1px solid rgba(57,255,20,0.4);
		padding-bottom: 1px;
		transition: color 0.2s, border-color 0.2s;
	}
	.pub-link:hover {
		color: var(--gfp);
		border-color: var(--gfp);
	}
</style>
